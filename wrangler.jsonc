{
  // Publicação no Cloudflare Workers (OpenNext). O nome do Worker e o da ligação interna (WORKER_SELF_REFERENCE) PRECISAM ser iguais:
  // o erro 10143 do deploy veio de "name" = amostrasiteafisiopop e a ligação apontando para "afisiopop".
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amostrasiteafisiopop",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "amostrasiteafisiopop"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
